<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iot.platform.repository.ProductMapper">

    <!-- 产品结果映射 -->
    <resultMap id="BaseResultMap" type="com.iot.platform.model.entity.Product">
        <id column="id" property="id"/>
        <result column="product_key" property="productKey"/>
        <result column="product_name" property="productName"/>
        <result column="product_type" property="productType"/>
        <result column="node_type" property="nodeType"/>
        <result column="net_type" property="netType"/>
        <result column="data_format" property="dataFormat"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, product_key, product_name, product_type, node_type, net_type,
        data_format, description, create_time, update_time, deleted
    </sql>

    <!-- 根据产品标识查询产品 -->
    <select id="selectByProductKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE product_key = #{productKey} AND deleted = 0
    </select>

</mapper>
