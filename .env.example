# ============================================================
# IoT 平台环境变量示例
# 复制为 .env 后按需修改，切勿将真实密钥提交到仓库
# ============================================================

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# Kafka / MQTT / InfluxDB
KAFKA_SERVERS=localhost:9092
MQTT_HOST=tcp://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
INFLUX_HOST=localhost
INFLUX_TOKEN=change-me-influx-token
INFLUX_PASSWORD=change-me-influx-password

# JWT（生产环境请使用足够长的随机字符串，至少 32 字节）
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# Spring Profile: local | dev | prod
SPRING_PROFILES_ACTIVE=local
